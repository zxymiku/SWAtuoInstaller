{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolidWorks Installer",
  "version": "1.0.0",
  "identifier": "com.solidworks.autoinstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SolidWorks 2024 SP5 · 部署终端",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Light",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SolidWorks Installer Contributors",
    "category": "DeveloperTool",
    "shortDescription": "SolidWorks 2024 SP5 自动安装程序",
    "longDescription": "全自动下载、解压、静默安装并激活 SolidWorks 2024 SP5 的部署终端，所有参数由 TOML 配置驱动。",
    "resources": [
      "resources/default-config.toml",
      "resources/7zr.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
